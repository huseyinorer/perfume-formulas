# Frontend Environment Variables
# Copy this file to .env and fill in your values

# API URL for backend connection
# Development: http://localhost:10000/api
# Production: Your deployed backend URL
VITE_API_URL=http://localhost:10000/api

# Shopier API
# Personal Access Token should stay only on backend env
SHOPIER_PAT=
SHOPIER_API_REGISTRY=@shopier/v1.0
SHOPIER_PRODUCT_IMAGE_BASE_URL=
SHOPIER_WEBHOOK_TOKEN=
SHOPIER_ACCOUNT_ID=

# Optional local fallback for development when Shopier API is not connected yet
SHOPIER_PRODUCTS_MOCK=[]
